+    const hasCamel = Object.hasOwn(google, "thoughtSignature");
+    if (!hasSnake && !hasCamel) return undefined;
+    for (const key of ["thought_signature", "thoughtSignature"]) {
+        if (Object.hasOwn(google, key) && (typeof google[key] !== "string" || google[key].length === 0)) {
+            throw new Error("Invalid Google tool-call thought signature");
+        }
+    }
+    return google;
+}
+function googleToolReplay(signature) {
+    if (!signature) return undefined;
+    let parsed;
+    try {
+        parsed = JSON.parse(signature);
+    } catch (error) {
+        // Other transports store opaque, non-JSON signatures in this same slot.
+        if (error instanceof SyntaxError) return undefined;
+        throw error;
